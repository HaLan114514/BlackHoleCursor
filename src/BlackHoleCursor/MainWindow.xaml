<Window x:Class="BlackHoleCursor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlackHole Cursor"
        Width="1040" Height="700"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#0CFFFFFF" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,26,16,14">
                    <TextBlock Text="BLACK HOLE" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <!-- v4（V4-8）：版本号随 v4 一起升（与 installer 里的 AppVersion 保持一致） -->
                    <TextBlock Text="CURSOR v4.0" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged">
                    <!-- v4：预设独立成页（V4-1），并排在外观之前 —— 挑预设是最高频的操作。
                         默认打开的仍是「外观」（IsSelected 留在下面那项，行为不变）。 -->
                    <ListBoxItem Content="预设" Tag="Presets" />
                    <ListBoxItem Content="外观" Tag="Appearance" IsSelected="True" />
                    <ListBoxItem Content="渲染与性能" Tag="Render" />
                    <ListBoxItem Content="引力透镜" Tag="Lens" />
                    <ListBoxItem Content="跟随与动效" Tag="Follow" />
                    <!-- v4：原「程序设置」页已并入这一页 -->
                    <ListBoxItem Content="系统与程序" Tag="System" />
                </ListBox>

                <StackPanel Grid.Row="2" Margin="20,0,20,22">
                    <TextBlock x:Name="TrayHint" Text="关闭窗口后仍会在托盘运行" FontSize="10"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="28,20,28,18" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="把鼠标变成一个黑洞" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="调参即时生效，无需重启。" Style="{StaticResource SectionHint}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="184" Height="184" CornerRadius="14" Margin="0,0,20,0"
                                Background="#FF04040A" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                                <!-- fixes-v2 问题 3：盘装不下时标注缩小倍率（真实比例时隐藏） -->
                                <TextBlock x:Name="PreviewScaleHint"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Margin="0,0,8,6" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="EnabledSwitch" Content="启用黑洞"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Style="{StaticResource BigSwitch}"
                                      Checked="EnabledSwitch_Changed" Unchecked="EnabledSwitch_Changed" />
                            <TextBlock x:Name="HotKeyHint" Margin="0,6,0,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="StatusLine" Margin="0,8,0,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="UndoButton" Content="撤销改动"
                                        Style="{StaticResource GhostButton}"
                                        Click="Undo_Click" />
                                <Button Content="隐藏到托盘" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" Click="HideToTray_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,18,28,8">
                <ContentControl x:Name="PageHost" />
            </ScrollViewer>

            <Border Grid.Row="2" Padding="28,14" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SavedHint" VerticalAlignment="Center" Margin="0,0,16,0"
                               FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    <Button Content="恢复默认" Style="{StaticResource GhostButton}" Click="Reset_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
