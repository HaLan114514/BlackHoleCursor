<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- plan-wgc W1：版本化 TFM（与 Core 一致），WGC 需要 WinRT 互操作。
         代价：最低系统要求抬到 Win10 2004（build 19041）一档，你已确认接受。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BlackHoleCursor</RootNamespace>

    <!-- v4（V4-6）：程序图标。两张 ICO 由 `tools/IconGen` 生成后提交到这里，
         编译不依赖那个工具（它只是生成器）。exe 的图标就来自这一行。 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同时启用 WinForms（取色器/图标）与 WPF，移除隐式 using 以避免 Application/UserControl 等命名冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackHoleCursor.Core\BlackHoleCursor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 禁用态那张不进 exe 图标（ApplicationIcon 只能有一张），但要作为资源打进去给托盘用 -->
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app-off.ico" />
  </ItemGroup>

</Project>
