<UserControl x:Class="BlackHoleCursor.UI.Controls.ToggleRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,2,16,0" />
        </StackPanel>
        <CheckBox Grid.Column="1"
                  IsChecked="{Binding IsOn, ElementName=Root, Mode=TwoWay}"
                  VerticalAlignment="Center" />
    </Grid>
</UserControl>
