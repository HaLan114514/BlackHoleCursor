<UserControl x:Class="BlackHoleCursor.UI.Views.RenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BlackHoleCursor.UI.Controls"
             xmlns:core="clr-namespace:BlackHoleCursor.Core;assembly=BlackHoleCursor.Core">
    <StackPanel>

        <TextBlock Text="渲染与性能" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="画面观感与性能开销。曝光与星空 / 星云影响观感，积分步数直接决定 GPU 负担。"
                   Style="{StaticResource SectionHint}" />

        <!-- v4（V4-4）：这一整块是从「外观」页搬过来的，原来的渲染相关控件集中在这里。
             引力透镜的开关不在此页（唯一入口在「引力透镜」页）。 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="渲染" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                <controls:SliderRow Label="曝光"
                                    Minimum="{x:Static core:SettingsRanges.ExposureMin}"
                                    Maximum="{x:Static core:SettingsRanges.ExposureMax}"
                                    Value="{Binding Exposure, Mode=TwoWay}" />
                <controls:SliderRow Label="星空强度"
                                    Minimum="{x:Static core:SettingsRanges.StarGainMin}"
                                    Maximum="{x:Static core:SettingsRanges.StarGainMax}"
                                    Value="{Binding StarGain, Mode=TwoWay}" />
                <!-- fixes-v2 问题 1：程序化背景光。不依赖抓屏内容，暗背景下也能保住光效层次 -->
                <controls:SliderRow Label="星云强度"
                                    Minimum="{x:Static core:SettingsRanges.NebulaGainMin}"
                                    Maximum="{x:Static core:SettingsRanges.NebulaGainMax}"
                                    Value="{Binding NebulaGain, Mode=TwoWay}" />
                <!-- fixes-v2 问题 6：星云亮部配色。预设会带自己的色调（M5.2 的唯一例外），
                     这里保留一个手动覆盖的入口。 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="146" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="星云色调" Style="{StaticResource FieldLabel}" ToolTip="星云亮部的颜色（暗部为它的去饱和暗版本，不再固定偏蓝）" />
                    <Button Grid.Column="1" x:Name="NebulaColorButton" Width="92" Height="30" Click="NebulaColor_Click" Cursor="Hand">
                        <Rectangle x:Name="NebulaSwatch" Width="76" Height="18" RadiusX="4" RadiusY="4" />
                    </Button>
                </Grid>
                <!-- fixes-v3 问题 2：星空闪烁 + 星云流动的速度倍率（1 = 原速，0 = 冻结，最大 3 倍速） -->
                <controls:SliderRow Label="氛围流速"
                                    Minimum="{x:Static core:SettingsRanges.AmbientFlowSpeedMin}"
                                    Maximum="{x:Static core:SettingsRanges.AmbientFlowSpeedMax}"
                                    Value="{Binding AmbientFlowSpeed, Mode=TwoWay}" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="146" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="积分步数" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" x:Name="QualityBox" Width="150"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding QualitySteps, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
