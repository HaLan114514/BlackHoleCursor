<UserControl x:Class="BlackHoleCursor.UI.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BlackHoleCursor.UI.Controls">
    <StackPanel>

        <TextBlock Text="系统与程序" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="黑洞必须隐藏系统箭头才能自绘。开启智能兜底后，进入全屏游戏等无法绘制的场景会自动把箭头还给你。"
                   Style="{StaticResource SectionHint}" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <controls:ToggleRow Label="隐藏系统光标"
                                    Description="关闭后立刻恢复系统箭头"
                                    IsOn="{Binding HideSystemCursor, Mode=TwoWay}" />
                <controls:ToggleRow Label="智能兜底"
                                    Description="全屏游戏 / 演示模式 / 锁屏时自动恢复系统箭头"
                                    IsOn="{Binding AutoFallback, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- v4：从「程序设置」页搬来 —— 两个页合并为「系统与程序」 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="程序运行" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                <controls:ToggleRow Label="开机自启"
                                    Description="写入当前用户的注册表 Run 项，无需管理员权限"
                                    IsOn="{Binding AutoStart, Mode=TwoWay}" />
                <controls:ToggleRow Label="截图补偿"
                                    Description="覆盖层被排除出系统捕获（否则会出现镜像回廊），全屏截图里没有黑洞。开启后检测到剪贴板出现全屏截图，就把黑洞合成回去再让你粘贴"
                                    IsOn="{Binding ScreenshotCompensation, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="运行状态" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                <TextBlock x:Name="CursorState" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                <TextBlock x:Name="FallbackState" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
                <TextBlock x:Name="RenderState" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
                <Button Content="立即恢复系统光标" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Margin="0,14,0,0" Click="RestoreCursor_Click" />
            </StackPanel>
        </Border>

        <!-- v4：配置文件这一组也从「程序设置」页搬来（含退出程序，放最后） -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="配置文件" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                <TextBlock x:Name="ConfigPath" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="打开所在目录" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" Margin="0,0,10,0" />
                    <Button Content="全部恢复默认" Style="{StaticResource GhostButton}" Click="Reset_Click" Margin="0,0,10,0" />
                    <Button Content="退出程序" Style="{StaticResource GhostButton}" Click="Exit_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
