<UserControl x:Class="BlackHoleCursor.UI.Views.PresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="预设" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="预设只改外观：大小与性能档位保留你当前的选择。内置预设只读，「我的预设」可以另存、覆盖、重命名与删除。"
                   Style="{StaticResource SectionHint}" />

        <!-- v4（V4-1）：内置预设 —— 只读，只能应用 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="内置" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                <WrapPanel x:Name="BuiltInPanel" />
            </StackPanel>
        </Border>

        <!-- v4（V4-1 / V4-2）：「我的」预设 —— 应用 / 覆盖保存 / 重命名 / 删除 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="我的预设" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                <StackPanel x:Name="CustomPanel" />
                <TextBlock x:Name="EmptyHint"
                           Text="还没有自定义预设 —— 调好外观后在下面「另存为」一个。"
                           Style="{StaticResource SectionHint}"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBox x:Name="PresetNameBox" Width="150" Text="我的预设" />
                    <Button Content="另存为预设" Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" Click="SavePreset_Click" />
                </StackPanel>

                <!-- v4（V4-3）：导出 / 导入 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="导出" Style="{StaticResource GhostButton}"
                            Click="Export_Click"
                            ToolTip="把「我的预设」存成一个 .json 文件" />
                    <Button Content="导入" Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            Click="Import_Click"
                            ToolTip="从 .json 文件合并预设；重名时可以选覆盖或另存为副本" />
                </StackPanel>

                <TextBlock x:Name="PresetHint"
                           Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
